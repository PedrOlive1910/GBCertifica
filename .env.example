APP_CONFIG=development
APP_VERSION=1.0
APP_TIMEZONE=America/Sao_Paulo
SECRET_KEY=coloque-aqui-uma-chave-secreta-grande
DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/sistema_tst_homolog
DOCUMENTS_ROOT=storage/documentos

# Usado somente para criar o primeiro administrador com python criar_banco.py.
TENANT_NAME=Conta Principal
TENANT_SLUG=conta-principal
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@sistematst.local
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Sessão e recuperação de senha
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_FAILURES=5
LOGIN_BLOCK_MINUTES=15
APP_BASE_URL=https://sistema.seudominio.com.br
SMTP_HOST=smtp.seuprovedor.com.br
SMTP_PORT=587
SMTP_USER=nao-responda@seudominio.com.br
SMTP_PASSWORD=senha-do-email
SMTP_USE_TLS=true
MAIL_FROM=nao-responda@seudominio.com.br

